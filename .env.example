# OpenAI API Key (required if using LLM processing)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Cloud credentials file path (default: credentials.json)
# You can also set GOOGLE_APPLICATION_CREDENTIALS to point to your service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Optional: Override config file path
# CONFIG_PATH=config.yaml

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
