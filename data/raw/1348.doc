\par {\listtext\pard\plain\fs21\insrsid14512757\charrsid6311911 \hich\af0\dbch\af0\loch\f0 a)\tab}}\pard \ql \fi-360\li720\ri0\widctlpar\jclisttab\tx720\aspalpha\aspnum\faauto\ls3\adjustright\rin0\lin720\itap0\pararsid14512757 {
\f0\fs21\insrsid14512757\charrsid6311911 Teshuva - improving our ways
\par {\listtext\pard\plain\fs21\insrsid14512757\charrsid6311911 \hich\af0\dbch\af0\loch\f0 b)\tab}Judgment Day
\par {\listtext\pard\plain\fs21\insrsid14512757\charrsid6311911 \hich\af0\dbch\af0\loch\f0 c)\tab}Independence day
\par {\listtext\pard\plain\fs21\insrsid14512757\charrsid6311911 \hich\af0\dbch\af0\loch\f0 d)\tab}Election day
\par {\listtext\pard\plain\fs21\insrsid14512757\charrsid6311911 \hich\af0\dbch\af0\loch\f0 e)\tab}Birthday of the World
