   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Jewish Holiday Sukkoth</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A sukkah with table, chairs and decorations. A sukkah is a temporary hut constructed for use during the week-long Jewish festival of Sukkot. It is topped with branches and often well decorated with autumnal, harvest or Judaic themes.</rdf:li>
    </rdf:Alt>
   </dc:description>
