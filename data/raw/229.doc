\i\f77\fs20\cf2\insrsid14899619 {\*\bkmkend n45}) Likkutei Levi Yitzchak, Igros, p. 355.
\par {\listtext\pard\plain\ltrpar \rtlch \ai\af0\afs20\alang1025 \ltrch \i\f77\fs20\cf2\insrsid14899619 \hich\af77\dbch\af0\loch\f77 46.\tab}}\pard \ltrpar\ql \fi-360\li2160\ri0\sb100\sa100\sbauto1\saauto1\widctlpar
