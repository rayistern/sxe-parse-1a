\i\f77\fs20\cf2\insrsid14899619  HYPERLINK "http://www.sichosinenglish.org/books/upsherinish/03.htm" \\l "t46" }}{\fldrslt {\rtlch \ai\af0\afs20 \ltrch \cs16\i\f77\fs20\ul\cf6\insrsid14899619 Back to text}}}{\rtlch \ai\af0\afs20 \ltrch 
\i\f77\fs20\cf2\insrsid14899619 {\*\bkmkend n46}) Traditional Jewish toasts for good fortune.
\par {\listtext\pard\plain\ltrpar \rtlch \ai\af0\afs20\alang1025 \ltrch \i\f77\fs20\cf2\insrsid14899619 \hich\af77\dbch\af0\loch\f77 47.\tab}}\pard \ltrpar\ql \fi-360\li2160\ri0\sb100\sa100\sbauto1\saauto1\widctlpar
\jclisttab\tx720\aspalpha\aspnum\faauto\ls47\adjustright\rin0\lin2160\itap0\pararsid14899619 {\rtlch \ai\af0\afs20 \ltrch \i\f77\fs20\cf2\insrsid14899619 ({\*\bkmkstart n47}}{\field\fldedit{\*\fldinst {\rtlch \ai\af0\afs20 \ltrch 
