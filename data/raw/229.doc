\par {\listtext\pard\plain\ltrpar \rtlch \ai\af0\afs20\alang1025 \ltrch \i\f77\fs20\cf2\insrsid14899619 \hich\af77\dbch\af0\loch\f77 6.\tab}}\pard \ltrpar\ql \fi-360\li720\ri0\sb100\sa100\sbauto1\saauto1\widctlpar
